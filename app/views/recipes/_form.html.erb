<%= form_with(model: recipe, class: "space-y-4") do |form| %>
  <% if recipe.errors.any? %>
    <ul>
      <% recipe.errors.each do |error| %>
        <li role="alert" class="alert alert-error my-4"><%= error.full_message %></li>
      <% end %>
    </ul>
  <% end %>

  <fieldset class="fieldset">
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, class: "input" %>
  </fieldset>

  <fieldset class="fieldset">
    <%= form.label :prep_time_minutes, class: "label" %>
    <%= form.number_field :prep_time_minutes, class: "input" %>
  </fieldset>

  <%# TODO: Put ingredient fields into table %>
  <div data-controller="ingredients-form">
    <h3 class="font-bold">Zutaten</h3>

    <div data-ingredients-form-target="fields" class="space-y-4 my-6">
      <%= form.fields_for :ingredients do |ingredient_form| %>
        <%= render "ingredient_fields", f: ingredient_form %>
      <% end %>
    </div>

    <template data-ingredients-form-target="template">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_form| %>
        <%= render "ingredient_fields", f: ingredient_form %>
      <% end %>
    </template>

    <button data-action="click->ingredients-form#add" class="btn btn-success">+</button>
  </div>

  <fieldset class="fieldset">
    <%= form.label :instructions, class: "label" %>
    <%= form.textarea :instructions, class: "textarea h-32 w-64" %>
  </fieldset>

  <fieldset class="fieldset">
    <%= form.label :is_published, class: "label" %>
    <%= form.checkbox :is_published, class: "checkbox checkbox-primary" %>
  </fieldset>

  <div>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
