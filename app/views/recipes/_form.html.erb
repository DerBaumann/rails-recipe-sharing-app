<%= form_with(model: recipe) do |form| %>
  <% if recipe.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(recipe.errors.count, "error") %>
        prohibited this recipe from being saved:</h2>

      <ul>
        <% recipe.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :prep_time_minutes, style: "display: block" %>
    <%= form.number_field :prep_time_minutes %>
  </div>

  <div data-controller="ingredients-form">
    <h3>Zutaten</h3>

    <div data-ingredients-form-target="fields">
      <%= form.fields_for :ingredients do |ingredient_form| %>
        <%= render "ingredient_fields", f: ingredient_form %>
      <% end %>
    </div>

    <template data-ingredients-form-target="template">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_form| %>
        <%= render "ingredient_fields", f: ingredient_form %>
      <% end %>
    </template>

    <button data-action="click->ingredients-form#add">+</button>
  </div>

  <div>
    <%= form.label :instructions, style: "display: block" %>
    <%= form.textarea :instructions %>
  </div>

  <div>
    <%= form.label :is_published, style: "display: block" %>
    <%= form.checkbox :is_published %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
