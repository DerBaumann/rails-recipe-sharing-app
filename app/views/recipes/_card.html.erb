<%= tag.div id: local_assigns[:card_id], class: "card bg-base-100 shadow-xl border" do %>
  <div class="card-body">
    <h2 class="card-title">
      <%= link_to recipe.title, recipe_path(recipe), class: "link link-hover" %>
    </h2>

    <p class="text-sm text-gray-500">
      Kochzeit:
      <%= recipe.prep_time_minutes %>
      Min. | Von:
      <%= recipe.user.email_address %>
      |
      <%= recipe.ingredients.count %>
      Zutaten
    </p>

    <div class="card-actions justify-between items-center mt-4">
      <div class="flex gap-1">
        <%# TODO: Ratings %>
        <% 5.times do %>
          <%= heroicon "star", options: { class: "size-6 text-yellow-500" } %>
        <% end %>
      </div>
      <%= render "favourites/toggle_button", recipe: recipe %>
    </div>
  </div>
<% end %>
