<div id="<%= dom_id(comment) %>" class="card bg-base-100 border p-4 my-3">
  <div class="flex justify-between items-start">
    <div>
      <div class="rating rating-sm gap-1 mb-1">
        <% 1.upto(5) do |i| %>
          <input
            type="radio"
            class="mask mask-star-2 bg-amber-400 cursor-default"
            disabled
            <%= "checked" if i == comment.rating %>
          />
        <% end %>
      </div>

      <h4 class="font-bold text-lg"><%= comment.title %></h4>
      <p class="text-xs text-neutral-500">
        Von
        <%= comment.author.email_address %>
        am
        <%= l(comment.created_at, format: :short) %>
      </p>
    </div>

    <% if comment.author == Current.user %>
      <%= button_to "Löschen",
      recipe_comment_path(recipe, comment),
      method: :delete,
      class: "btn btn-xs btn-ghost text-error" %>
    <% end %>
  </div>

  <% if comment.body.present? %>
    <p class="mt-2 text-sm text-neutral-700 whitespace-pre-wrap"><%= comment.body %></p>
  <% end %>
</div>
