<div
  id="<%= dom_id recipe %>"
  class="border rounded-lg p-4 flex flex-col justify-between w-fit gap-4"
>
  <div class="flex justify-between gap-8">
    <p>
      <strong><%= recipe.title %></strong>
    </p>
    <div>
      <p><%= recipe.prep_time_minutes %>min.</p>
      <p><%= recipe.ingredients.count %>
        Zutaten</p>
    </div>
  </div>

  <div class="flex justify-between gap-8">
    <p>TODO: Rating</p>
    <p>TODO: Favourites</p>
  </div>
  <p>
    <%= link_to "Show this recipe", recipe, class: "link" %>
  </p>
</div>
