<div id="<%= dom_id recipe %>">
  <div>
    <strong>Title:</strong>
    <%= recipe.title %>
  </div>

  <div>
    <strong>Prep time minutes:</strong>
    <%= recipe.prep_time_minutes %>
  </div>

  <div>
    <p><strong>Zutaten</strong></p>
    <ul>
      <% recipe.ingredients.each do |ingredient| %>
        <li>
          <%= ingredient.amount %>
          <%= ingredient.unit %>
          <%= ingredient.name %>
        </li>
      <% end %>
    </ul>
  </div>

  <div>
    <strong>Instructions:</strong>
    <%= recipe.instructions %>
  </div>

  <div>
    <strong>Is published:</strong>
    <%= recipe.is_published %>
  </div>

</div>
