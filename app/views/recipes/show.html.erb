<% if notice %>
  <div role="alert" class="alert alert-success mb-4">
    <%= heroicon "check-badge", options: { class: "w-6" } %>
    <span><%= notice %></span>
  </div>
<% end %>

<h1 class="h1"><%= @recipe.title %></h1>

<%# TODO: Favourites count %>
<p>
  <%= render "favourites/toggle_button", recipe: @recipe %>
</p>

<p><%= @recipe.prep_time_minutes %>min. Kochzeit</p>

<ul class="list list-disc">
  <% @recipe.ingredients.each do |ingredient| %>
    <li class="list-item">
      <%= ingredient.amount %>
      <%= ingredient.unit %>
      <%= ingredient.name %>
    </li>
  <% end %>
</ul>

<div class="prose max-w-none">
  <%= simple_format(@recipe.instructions) %>
</div>

<div class="flex gap-4">
  <%= link_to "Back to recipes", recipes_path, class: "btn btn-neutral" %>
  <% if @recipe.owned_by?(Current.user) %>
    <%= button_to "Destroy this recipe",
    @recipe,
    method: :delete,
    class: "btn btn-error" %>
    <%= link_to "Edit this recipe", edit_recipe_path(@recipe), class: "btn btn-primary" %>
  <% end %>
</div>

<hr/>
